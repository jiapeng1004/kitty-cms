{
  "name": "kitty-cms-frontend",
  "version": "1.0.0",
  "description": "Frontend for Kitty CMS",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w admin",
    "build": "npm run build -w admin",
    "preview": "npm run preview -w admin",
    "dev:admin": "npm run dev -w admin",
    "dev:mobile": "npm run dev -w mobile",
    "dev:transcoder": "npm run dev -w transcoder",
    "dev:new": "npm run dev -w new-project",
    "build:admin": "npm run build -w admin",
    "build:mobile": "npm run build -w mobile",
    "build:transcoder": "npm run build -w transcoder",
    "build:new": "npm run build -w new-project",
    "preview:admin": "npm run preview -w admin",
    "preview:new": "npm run preview -w new-project",
    "build:all": "npm run build -w admin && npm run build -w mobile && npm run build -w transcoder && npm run build -w new-project"
  },
  "keywords": [],
