# Environment Configuration Example
# Copy this file to .env and fill in your values

# Application
APP_NAME="kitty-sentiment"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_TYPE=mysql
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=sentiment
DATABASE_USER=root
DATABASE_PASSWORD=your_password

# Doris (Optional)
DORIS_HOST=localhost
DORIS_PORT=9030
DORIS_DATABASE=sentiment_analytics
DORIS_USER=root
DORIS_PASSWORD=your_password

# Crawler
CRAWLER_USER_AGENT="Mozilla/5.0 (compatible; KittySentimentBot/1.0)"
CRAWLER_DELAY=1.0
CRAWLER_TIMEOUT=30
CRAWLER_MAX_RETRIES=3

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Security (Future)
JWT_SECRET=your_secret_key_here
JWT_EXPIRY_HOURS=24
