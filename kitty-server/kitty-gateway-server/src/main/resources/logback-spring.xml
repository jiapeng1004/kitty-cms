<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 1. 引入 Spring Boot 自动配置，避免重复定义控制台等基础 Appender -->
    <include resource="org/springframework/boot/logging/logback/base.xml"/>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="gateway-service"/>
    <springProperty scope="context" name="logLevel" source="log.level" defaultValue="info"/>

    <!-- 控制台输出：这是 K8s 环境下的主要日志来源 -->
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- 适配 Spring Cloud 链路追踪的 MDC 格式 [citation:1] -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [${appName},%X{traceId},%X{spanId}] [%thread] %logger{36} -
                %msg%n
            </pattern>
            <charset>utf-8</charset>
        </encoder>
    </appender>

    <!-- 设置应用自身的日志级别 -->
    <logger name="com.your.gateway.package" level="${logLevel}"/>

    <!-- 全局日志级别 -->
    <root level="INFO">
        <appender-ref ref="console"/>
    </root>
</configuration>